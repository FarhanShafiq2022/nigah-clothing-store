{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Validate pagination",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"lint"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Build pagination fix",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Deploy pagination fix",
			"type": "shell",
			"command": "npx",
			"args": [
				"firebase-tools",
				"deploy",
				"--only",
				"hosting"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}